# .env.example

# --- INFRASTRUCTURE & DATABASE (POSTGRES) ---------------------------------- # 
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/your_db

# --- BACKEND (GO API & AUTHENTICATION) ------------------------------------- #
PORT=8080
JWT_SECRET=your_secret_key

# --- BACKEND (AI SERVICES) ------------------------------------------------- #
GOOGLE_API_KEY=you_secrey_api_key

# --- THIRD-PARTY APIs ------------------------------------------------------ #
RESEND_API_KEY=your_resend_api_key_here

GOOGLE_CLIENT_ID=your_google_uid_here
GOOGLE_CLIENT_SECRET=your_google_secret_here

GITHUB_CLIENT_ID=your_github_uid_here
GITHUB_CLIENT_SECRET=your_github_secret_here

FT_CLIENT_ID=your_42_intra_uid_here
FT_CLIENT_SECRET=your_42_intra_secret_here

# --- FRONTEND -------------------------------------------------------------- #
FRONTEND_URL=https://localhost:8443
# Host port for nginx. Not 443 because rootless Podman (which `docker` may be
# an alias for) can't bind ports below 1024. Keep FRONTEND_URL's port in sync.
HTTPS_PORT=8443
